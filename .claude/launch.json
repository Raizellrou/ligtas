{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ligtas-pwa",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ligtas/pwa", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "ligtas-hub",
      "runtimeExecutable": "node",
      "runtimeArgs": ["packages/hub/dist/index.js"],
      "port": 3001
    },
    {
      "name": "ligtas-pwa-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ligtas/pwa", "preview", "--port", "4173"],
      "port": 4173
    }
  ]
}
