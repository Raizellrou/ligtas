# Copy to packages/hub/.env (already gitignored -- never commit the real
# file) and fill in real values. Loaded via `node --env-file=.env`, Node's
# own built-in flag (20.6+, stable on the 24.x this repo targets) -- no
# dotenv dependency needed. See docs/ONBOARDING.md Section 4 for what each
# variable does and where to get real values.

# The hub's own Stellar Testnet account -- enables the drain worker.
# Leave unset to run with anchoring/payout disabled.
LIGTAS_HUB_STELLAR_SECRET=

# How often the drain worker runs automatically once the secret above is set.
LIGTAS_DRAIN_INTERVAL_MS=60000

# Enables the Tester tab's "Live mesh demo" panel (docs/ONBOARDING.md
# Section 4.3). Off by default deliberately -- this spawns local processes,
# which is more sensitive than anything else the hub does with no auth.
# Never set this on a hub anyone outside your own machine can reach.
LIGTAS_ENABLE_MESH_ORCHESTRATION=0

# Required for the "Run bridge_to_hub.py" button / the manual command it
# replaces. Must match a public key already registered in
# packages/hub/config/issuers.json.
LIGTAS_DEMO_ISSUER_SECRET=
LIGTAS_DEMO_ISSUER_INDEX=0
